{
	"info": {
		"name": "Product Inventory API - Demo",
		"description": "The requests of the demo, in order. Restart the server before the demo: the tests expect the sample data. The speaker notes are in postman/DEMO.md.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. See the inventory",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"There are 4 products\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.length).to.eql(4);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "2. Create a category",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Electronics\",\n    \"description\": \"Phones, computers and accessories\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/categories",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"categories"
					]
				}
			},
			"response": []
		},
		{
			"name": "3. Create a supplier",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Tech World\",\n    \"contact\": \"Jane Doe\",\n    \"email\": \"jane@techworld.com\",\n    \"phone\": \"+1 555 0199\",\n    \"address\": \"10 Market Street\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/suppliers",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"suppliers"
					]
				}
			},
			"response": []
		},
		{
			"name": "4. Create a product",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Its stock is empty\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.quantity).to.eql(0);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"sku\": \"MOUSE-1\",\n    \"name\": \"Wireless Mouse\",\n    \"price\": 19.99,\n    \"category\": \"Electronics\",\n    \"supplier\": \"Tech World\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "5. Receive a delivery",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"30 units in stock\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.stockAfter).to.eql(30);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"in\",\n    \"quantity\": 30,\n    \"reason\": \"Delivery\",\n    \"to\": \"Warehouse 1\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products/MOUSE-1/movements",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"MOUSE-1",
						"movements"
					]
				}
			},
			"response": []
		},
		{
			"name": "6. Transfer to another warehouse",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"The total does not change\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.stockAfter).to.eql(30);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"transfer\",\n    \"quantity\": 10,\n    \"reason\": \"Restock\",\n    \"from\": \"Warehouse 1\",\n    \"to\": \"Warehouse 3\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products/MOUSE-1/movements",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"MOUSE-1",
						"movements"
					]
				}
			},
			"response": []
		},
		{
			"name": "7. Sell some units",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"25 units left\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.stockAfter).to.eql(25);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"out\",\n    \"quantity\": 5,\n    \"reason\": \"Sale\",\n    \"from\": \"Warehouse 3\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products/MOUSE-1/movements",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"MOUSE-1",
						"movements"
					]
				}
			},
			"response": []
		},
		{
			"name": "8. A sale that is refused",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 409\", function () {",
							"    pm.response.to.have.status(409);",
							"});",
							"",
							"pm.test(\"The error message is clear\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.error).to.eql(\"Not enough stock in Warehouse 3: only 5 available\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"out\",\n    \"quantity\": 10,\n    \"reason\": \"Sale\",\n    \"from\": \"Warehouse 3\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/products/MOUSE-1/movements",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"MOUSE-1",
						"movements"
					]
				}
			},
			"response": []
		},
		{
			"name": "9. The history of the product",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"3 movements: the refused one is not there\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.map(m => m.type)).to.eql([\"in\", \"transfer\", \"out\"]);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products/MOUSE-1/movements",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products",
						"MOUSE-1",
						"movements"
					]
				}
			},
			"response": []
		},
		{
			"name": "10. What is in Warehouse 3?",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Product 4 and the mouse\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.map(p => p.sku)).to.eql([\"Product 4\", \"MOUSE-1\"]);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/warehouses/Warehouse%203/products",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"warehouses",
						"Warehouse%203",
						"products"
					]
				}
			},
			"response": []
		},
		{
			"name": "11. What must be ordered again?",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Product 3, then Product 2\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.map(p => p.sku)).to.eql([\"Product 3\", \"Product 2\"]);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/products?lowStock=true&sort=price&order=desc",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"products"
					],
					"query": [
						{
							"key": "lowStock",
							"value": "true"
						},
						{
							"key": "sort",
							"value": "price"
						},
						{
							"key": "order",
							"value": "desc"
						}
					]
				}
			},
			"response": []
		},
		{
			"name": "12. A deletion that is refused",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 409\", function () {",
							"    pm.response.to.have.status(409);",
							"});",
							"",
							"pm.test(\"The error message is clear\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.error).to.eql(\"Cannot delete category with associated products\");",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/categories/Electronics",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"categories",
						"Electronics"
					]
				}
			},
			"response": []
		},
		{
			"name": "13. The statistics",
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test(\"Status is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"5 products, 100 units, 2099 of value\", function () {",
							"    const body = pm.response.json();",
							"    pm.expect(body.totalProducts).to.eql(5);",
							"    pm.expect(body.totalUnits).to.eql(100);",
							"    pm.expect(body.stockValue).to.eql(2099);",
							"});"
						]
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/stats",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"stats"
					]
				}
			},
			"response": []
		}
	],
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// This test runs after every request of the collection",
					"pm.test(\"The answer is JSON\", function () {",
					"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		}
	]
}
